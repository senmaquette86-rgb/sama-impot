# Configuration du backend Sama Impôt
# Copiez ce fichier en « .env » et adaptez les valeurs.

# Clé secrète Django (générez-en une longue et aléatoire en production)
SECRET_KEY=changez-cette-cle-en-production

# Mode debug : True en développement, False en production
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL (laisser vide pour utiliser SQLite en local)
# Exemple : postgres://utilisateur:motdepasse@hote:5432/nom_base
DATABASE_URL=

# Origines autorisées pour le frontend React
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Origines de confiance pour le CSRF (en production)
CSRF_TRUSTED_ORIGINS=

# Envoi d'emails (code de vérification à l'inscription)
# Par défaut, les emails s'affichent dans le terminal (aucune valeur requise).
# Pour un envoi réel via Gmail : créez un "mot de passe d'application" sur
# https://myaccount.google.com/apppasswords puis renseignez :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=votre-adresse@gmail.com
# EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
# DEFAULT_FROM_EMAIL=Sama Impôt <votre-adresse@gmail.com>
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sama Impôt <no-reply@samaimpot.sn>
